# Stripe Keys - get these from https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Base URL for redirect after checkout
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Email reminders (Resend — resend.com) ──────────────────────────────────────
RESEND_API_KEY=re_...
# Must be a verified sender domain in your Resend account
REMINDER_FROM_EMAIL=FreshTable <noreply@yourdomain.com>

# ── SMS reminders (Twilio — twilio.com) ────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# A Twilio phone number you own, in E.164 format e.g. +15551234567
TWILIO_PHONE_NUMBER=+1...

# ── Cron security ──────────────────────────────────────────────────────────────
# Set a random secret and include it as: Authorization: Bearer <CRON_SECRET>
# when calling POST /api/send-reminders from your scheduler.
# Leave blank to disable auth (not recommended in production).
CRON_SECRET=
